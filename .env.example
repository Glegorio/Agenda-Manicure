# Copie para .env e preencha. NUNCA commite .env.
# (O Claude Code está configurado para não ler arquivos .env — só este exemplo.)

# --- Banco ---
DATABASE_URL=postgresql://agende:agende@localhost:5433/agende?schema=public

# --- API ---
API_PORT=3333
JWT_ACCESS_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_BASE_URL=http://localhost:3000

# --- WhatsApp (ADR-0004) ---
WHATSAPP_PROVIDER=noop          # noop | zapi | cloud
WHATSAPP_ZAPI_INSTANCE_ID=
WHATSAPP_ZAPI_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# --- Storage de imagens (Q-09) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Observabilidade (fase 8) ---
SENTRY_DSN=

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333/v1

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:3333/v1
